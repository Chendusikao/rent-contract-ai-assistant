# 租房合同 AI 分析助手 - 环境配置
# 使用方法：复制此文件为 .env，填入你自己的配置
# cp .env.example .env

# ========== DeepSeek API Key（必填）==========
# 在 https://platform.deepseek.com/api_keys 获取
# 注意：这是你自己的 Key，费用由你的账户承担，切勿把 .env 文件发给他人
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ========== DeepSeek API 地址（可选，默认 https://api.deepseek.com）==========
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ========== Embedding 模型下载代理（可选）==========
# 首次运行需要从 HuggingFace 下载本地向量模型（约 90MB）
# 若网络无法直连，请开启代理软件并设置此处地址（默认已指向 127.0.0.1:7890）
# EMBEDDING_PROXY=http://127.0.0.1:7890
